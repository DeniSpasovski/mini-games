# Template for the local, untracked environment file.
#
#   cp .env.example .env.local      (macOS / Linux)
#   copy .env.example .env.local    (Windows)
#
# `.env.local` is git-ignored (see .gitignore), Rsbuild loads it automatically for `npm run dev` and
# `npm run build`. Only variables starting with PUBLIC_ reach the browser bundle. Never commit real values.

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Optional: leave it empty and the cookie banner and
# analytics are removed. It is only loaded in production builds on a non-local host, after the visitor
# clicks Accept (see DETAILS.md "Analytics + cookie banner").
PUBLIC_GA_MEASUREMENT_ID=
