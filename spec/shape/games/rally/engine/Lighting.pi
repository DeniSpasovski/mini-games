use @piton/belay

from /rally/Lighting import Lighting

export instruction LightingShape:
    description: Guidance for the rally rendering engine's lighting.
    prompt:
        The stage lighting here follows @{Lighting}. Read it before you change
        the sun, the sky, the environment map or the HDRIs. Keep the sun light
        the only sun, keep the visible sky procedural, and never let a stage
        load wait on lighting without a fallback.
