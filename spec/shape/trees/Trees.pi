use @piton/belay

from /trees/ProceduralTrees import ProceduralTrees

export instruction TreesShape:
    description: Guidance for the procedural L-system tree code.
    prompt:
        The trees in this directory follow @{ProceduralTrees} and the documents
        it links to. Read the one for the stage you are changing before you
        change it. Keep derivation deterministic, keep every LOD built from
        the one skeleton, and never let a change of level swap geometry
        without the dithered cross-fade.
