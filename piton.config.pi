use @piton/belay
use @piton/config

from @piton/belay import ClaudeCodeAdapter

export piton-config MiniGames:
    root: ./spec
    entry: ./spec/index.pi

    frameworks:
        - {BelayConfiguration}

belay-config BelayConfiguration:
    codeRoot: ./src
    shapeRoot: ./spec/shape

    adapters:
        - {ClaudeCodeAdapter}
